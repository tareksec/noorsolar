# ==============================================================================
# NOOR SOLAR ENERGY — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# IMPORTANT:
# 1. Copy this file to .env on your production server.
# 2. Fill in real values for each variable before launching.
# 3. CRITICAL: DATABASE_URL and UPLOAD_DIR MUST point OUTSIDE the deployed
#    code folder (e.g. into a persistent directory such as /home/u123456789/data/)
#    so that future code deployments/updates or Git pulls NEVER wipe or overwrite
#    the SQLite database file or customer uploaded images.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Prisma / SQLite)
# ------------------------------------------------------------------------------
# Must be an absolute path outside the application deployment root.
# Example for Hostinger Node.js: "file:/home/u123456789/persistent_storage/production.db"
DATABASE_URL="file:/home/USERNAME/data/production.db"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# A cryptographically secure random string (at least 32 characters, 64 recommended).
# Generate on Linux/Mac with: openssl rand -hex 32
AUTH_SECRET="your-random-64-character-hex-secret-generated-with-openssl"

# Initial admin credentials used by `npm run db:seed`.
# In production, ADMIN_PASSWORD must be at least 12 characters and NOT a placeholder.
ADMIN_EMAIL="admin@noorsolaren.com"
ADMIN_PASSWORD="YourStrongInitialAdminPassword123!@#"

# ------------------------------------------------------------------------------
# 3. PERSISTENT UPLOADS DIRECTORY
# ------------------------------------------------------------------------------
# Directory where product images and documents uploaded via the admin panel are saved.
# Must point OUTSIDE the deployed code directory so updates do not delete uploads.
# Example for Hostinger: "/home/u123456789/persistent_storage/uploads"
UPLOAD_DIR="/home/USERNAME/data/uploads"

# ------------------------------------------------------------------------------
# 4. PUBLIC SITE URL
# ------------------------------------------------------------------------------
# The canonical public URL where the site is served (used for SEO, OG images, sitemap).
NEXT_PUBLIC_SITE_URL="https://noorsolaren.com"

# ------------------------------------------------------------------------------
# 5. RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV="production"

# ------------------------------------------------------------------------------
# 6. CONTENT POLICY & SEEDING CONTROLS
# ------------------------------------------------------------------------------
# Set to "true" to hide all sample trust content (unverified stats, certs, testimonials)
# until the business owner replaces them with real company data in the admin panel.
HIDE_SAMPLE_CONTENT="false"

# Controls `npm run db:seed` behavior in production:
# - If "false" or unset: seed ONLY creates the admin user and core categories (clean database).
# - If "true": seed populates the 15 demo products and sample trust items for testing.
SEED_DEMO="false"
